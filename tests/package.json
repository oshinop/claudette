{
  "name": "claudette-tests",
  "version": "0.1.0",
  "description": "End-to-end tests for claudette (the Rust crate in this repository), run in the Docker topology",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun test ./e2e --timeout 120000",
    "test:t3": "bun test ./t3 --timeout 180000",
    "test:paseo": "bun test ./paseo --timeout 180000"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "1.6.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
